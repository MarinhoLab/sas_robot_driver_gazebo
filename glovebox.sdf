<?xml version="1.0"?>
<sdf version="1.9">

  <model name="simplified_glovebox">

    <static>true</static>

    <link name="body">

      <!-- Main body: hollow shell made of individual wall panels (floor, lid,
           back, left, right), leaving the front open for the window so the
           interior is actually visible instead of being buried in solid material -->

      <!-- Floor -->
      <visual name="shell_floor_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.8 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <metalness>0.35</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="shell_floor_collision">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.8 0.02</size>
          </box>
        </geometry>
      </collision>

      <!-- Lid -->
      <visual name="shell_lid_visual">
        <pose>0 0 0.99 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.8 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <metalness>0.35</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="shell_lid_collision">
        <pose>0 0 0.99 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.8 0.02</size>
          </box>
        </geometry>
      </collision>

      <!-- Back wall -->
      <visual name="shell_back_visual">
        <pose>0 0.39 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.02 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <metalness>0.35</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="shell_back_collision">
        <pose>0 0.39 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.02 1.0</size>
          </box>
        </geometry>
      </collision>

      <!-- Left wall -->
      <visual name="shell_left_visual">
        <pose>-0.59 0 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.8 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <metalness>0.35</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="shell_left_collision">
        <pose>-0.59 0 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.8 1.0</size>
          </box>
        </geometry>
      </collision>

      <!-- Right wall -->
      <visual name="shell_right_visual">
        <pose>0.59 0 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.8 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <metalness>0.35</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="shell_right_collision">
        <pose>0.59 0 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.8 1.0</size>
          </box>
        </geometry>
      </collision>


      <!-- Front window: fills the open front face flush with the side/top/bottom
           walls (axis-aligned box, no rotation needed since its local x/y/z
           already line up with width/depth/height) -->
      <visual name="front_window">
        <pose>0 -0.39 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>1.16 0.02 0.96</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.70 0.45 0.45</ambient>
          <diffuse>0.75 0.70 0.45 0.45</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
        <transparency>0.55</transparency>
      </visual>

      <collision name="front_window_collision">
        <pose>0 -0.39 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>1.16 0.02 0.96</size>
          </box>
        </geometry>
      </collision>


      <!-- Internal work surface -->
      <visual name="worktop">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>1.10 0.70 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.85 1</ambient>
          <diffuse>0.82 0.82 0.85 1</diffuse>
          <specular>1 1 1 1</specular>
          <pbr>
            <metal>
              <metalness>0.45</metalness>
              <roughness>0.3</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="worktop_collision">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>1.10 0.70 0.02</size>
          </box>
        </geometry>
      </collision>


      <!-- Left glove port -->
      <visual name="glove_port_left">
        <pose>-0.18 -0.401 0.45 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 0.45</ambient>
          <diffuse>0.1 0.1 0.1 0.45</diffuse>
        </material>
        <transparency>0.55</transparency>
      </visual>


      <!-- Right glove port -->
      <visual name="glove_port_right">
        <pose>0.18 -0.401 0.45 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 0.45</ambient>
          <diffuse>0.1 0.1 0.1 0.45</diffuse>
        </material>
        <transparency>0.55</transparency>
      </visual>


      <!-- Side entry port -->
      <visual name="entry_port">
        <pose>0.601 0.0 0.50 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.38 0.45</ambient>
          <diffuse>0.35 0.35 0.38 0.45</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
          <pbr>
            <metal>
              <metalness>0.4</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
        <transparency>0.55</transparency>
      </visual>


      <!-- Drum 1 -->
      <visual name="drum1">
        <pose>-0.20 0.00 0.33 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.65 0.65 0.68 1</ambient>
          <diffuse>0.65 0.65 0.68 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <metalness>0.4</metalness>
              <roughness>0.4</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="drum1_collision">
        <pose>-0.20 0.00 0.33 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
      </collision>


      <!-- Drum 2 -->
      <visual name="drum2">
        <pose>0.15 -0.10 0.29 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.07</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.41 0.44 1</ambient>
          <diffuse>0.4 0.41 0.44 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
          <pbr>
            <metal>
              <metalness>0.4</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="drum2_collision">
        <pose>0.15 -0.10 0.29 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.07</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
      </collision>


      <!-- Equipment box -->
      <visual name="equipment_box">
        <pose>0.32 0.15 0.30 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.12 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.52 0.55 1</ambient>
          <diffuse>0.5 0.52 0.55 1</diffuse>
          <specular>0.85 0.85 0.85 1</specular>
          <pbr>
            <metal>
              <metalness>0.35</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="equipment_box_collision">
        <pose>0.32 0.15 0.30 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.12 0.18</size>
          </box>
        </geometry>
      </collision>


      <!-- Pipe section -->
      <visual name="pipe">
        <pose>0.0 0.22 0.28 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.55 0.55 0.58 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <metalness>0.4</metalness>
              <roughness>0.35</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="pipe_collision">
        <pose>0.0 0.22 0.28 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </collision>


      <!-- Interior lights: mounted just under the lid, shining down onto the
           worktop so the enclosure interior is lit through the window -->
      <light type="spot" name="interior_light_left">
        <pose>-0.3 0.05 1.2 0 0 0</pose>
        <direction>0 0 -1</direction>
        <cast_shadows>false</cast_shadows>
        <diffuse>1 1 1 1</diffuse>
        <specular>0.6 0.6 0.6 1</specular>
        <intensity>8.0</intensity>
        <attenuation>
          <range>3.0</range>
          <constant>0.2</constant>
          <linear>0.2</linear>
          <quadratic>0.05</quadratic>
        </attenuation>
        <spot>
          <inner_angle>0.6</inner_angle>
          <outer_angle>1.0</outer_angle>
          <falloff>1.0</falloff>
        </spot>
      </light>

      <light type="spot" name="interior_light_right">
        <pose>0.3 0.05 1.2 0 0 0</pose>
        <direction>0 0 -1</direction>
        <cast_shadows>false</cast_shadows>
        <diffuse>1 1 1 1</diffuse>
        <specular>0.6 0.6 0.6 1</specular>
        <intensity>8.0</intensity>
        <attenuation>
          <range>3.0</range>
          <constant>0.2</constant>
          <linear>0.2</linear>
          <quadratic>0.05</quadratic>
        </attenuation>
        <spot>
          <inner_angle>0.6</inner_angle>
          <outer_angle>1.0</outer_angle>
          <falloff>1.0</falloff>
        </spot>
      </light>

    </link>

  </model>

</sdf>
