<sdf version='1.11'>

    <model name="r820_position_controller">

    <include>
        <name>r820</name>
        <static>false</static>
        <uri>model://iiwa14.sdf</uri>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>joint1</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>joint2</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>joint3</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>joint4</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>joint5</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>joint6</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>joint7</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        </plugin>

    </include>

    </model>

</sdf>
