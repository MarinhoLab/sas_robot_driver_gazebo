<sdf version='1.11'>
    <world name="r820_world">

            <physics type="ode">
            <max_step_size>0.002</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>500</real_time_update_rate>
        </physics>
        <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
        <plugin filename="gz-sim-scene-broadcaster-system"  name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 5 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 -0.1 -0.9</direction>
            <intensity>2.0</intensity>
        </light>

        <model name="ground_plane">
          <static>true</static>
          <link name="link">
            <collision name="collision">
              <geometry>
                <plane>
                  <normal>0 0 1</normal>
                  <size>100 100</size>
                </plane>
              </geometry>
            </collision>
            <visual name="visual">
              <geometry>
                <plane>
                  <normal>0 0 1</normal>
                  <size>100 100</size>
                </plane>
              </geometry>
              <material>
                <ambient>0.8 0.8 0.8 1</ambient>
                <diffuse>0.8 0.8 0.8 1</diffuse>
                <specular>0.8 0.8 0.8 1</specular>
              </material>
            </visual>
          </link>
        </model>

        <model name="ranger">
            <pose>0 0 0.45 0 0 0</pose>

            <include>
                <name>ranger</name>
                <static>false</static>
                <uri>model://ranger.sdf</uri>
            </include>

            <include>
                <name>ur30_1_position_controller</name>
                <pose relative_to='ranger::base_link'>0 0 0.15 0 0 0</pose>
                <static>false</static>
                <uri>model://ur30_position_controller.sdf</uri>
            </include>

            <include>
                <name>ur3e_position_controller</name>
                <pose relative_to='ur30_1_position_controller::ur30_1::wrist_3_link'>0 0 0 0 0 0</pose>
                <static>false</static>
                <uri>model://ur3e_position_controller.sdf</uri>
            </include>

            <joint name='base_joint' type='fixed'>
                <pose relative_to='__model__'>0 0 0 0 0 0</pose>
                <parent>world</parent>
                <child>ranger::base_link</child>
            </joint>

            <joint name='ur30_1_ranger' type='fixed'>
                <pose relative_to='ranger::base_link'>0 0 0 0 0 0</pose>
                <parent>ranger::base_link</parent>
                <child>ur30_1_position_controller::ur30_1::base_link</child>
            </joint>

            <joint name='ur30_ur3e' type='fixed'>
                <pose relative_to='ur30_1_position_controller::ur30_1::wrist_3_link'>0 0 0 0 0 0</pose>
                <parent>ur30_1_position_controller::ur30_1::wrist_3_link</parent>
                <child>ur3e_position_controller::ur3e::base_link</child>
            </joint>

        </model>

        <include>
            <name>frame_x</name>
            <uri>model://frame.sdf</uri>
        </include>

        <include>
            <name>frame_xd</name>
            <uri>model://frame.sdf</uri>
        </include>

    </world>
</sdf>
