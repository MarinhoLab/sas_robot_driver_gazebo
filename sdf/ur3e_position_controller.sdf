<sdf version='1.11'>

    <model name="ur3e_position_controller">

    <include>
        <name>ur3e</name>
        <static>false</static>
        <uri>model://ur3e.sdf</uri>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>shoulder_pan_joint</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>shoulder_lift_joint</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>elbow_joint</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>wrist_1_joint</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>wrist_2_joint</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
            <joint_name>wrist_3_joint</joint_name>
            <use_velocity_commands>True</use_velocity_commands>
            <cmd_max>0.25</cmd_max>
        </plugin>

        <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        </plugin>

    </include>

    </model>

</sdf>
