<sdf version='1.11'>
    <world name="ur3e_position_world">

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 5 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 -0.1 -0.9</direction>
            <intensity>2.0</intensity>
        </light>


        <model name="ur3e_1">

            <include>
                <name>ur3e_1_position_controller</name>
                <static>false</static>
                <uri>model://ur3e_position_controller.sdf</uri>
            </include>

            <joint name='base_joint' type='fixed'>
                <pose relative_to='__model__'>0 0 0 0 0 0</pose>
                <parent>world</parent>
                <child>ur3e_1_position_controller::ur3e_1::base_link</child>
            </joint>

        </model>

        <include>
            <name>frame_x</name>
            <uri>model://frame.sdf</uri>
        </include>

        <include>
            <name>frame_xd</name>
            <uri>model://frame.sdf</uri>
        </include>

    </world>
</sdf>
