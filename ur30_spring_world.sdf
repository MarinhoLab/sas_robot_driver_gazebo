<sdf version='1.11'>
    <world name="ur3e_position_world">

    <light type="directional" name="sun">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 5 0 0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <direction>-0.5 -0.1 -0.9</direction>
        <intensity>2.0</intensity>
    </light>

    <model name="box">
      <pose relative_to='ur30_1::ur30_1_position_controller::ur30_1::wrist_3_joint'>0 0 0 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <inertia>
            <ixx>0.16666</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16666</iyy>
            <iyz>0</iyz>
            <izz>0.16666</izz>
          </inertia>
          <mass>1.0</mass>
        </inertial>
        <collision name="box_collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="box_visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>1 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="ur30_1">

        <include>
            <name>ur30_1_position_controller</name>
            <static>false</static>
            <uri>model://ur30_position_controller.sdf</uri>
        </include>

        <joint name='base_joint' type='fixed'>
            <pose relative_to='__model__'>0 0 0 0 0 0</pose>
            <parent>world</parent>
            <child>ur30_1_position_controller::ur30_1::base_link</child>
        </joint>

    </model>

    <joint name='eff_connection' type='prismatic'>
        <pose relative_to='ur30_1::ur30_1_position_controller::ur30_1::wrist_3_joint'>0 0 0.2 0 0 0</pose>
        <parent>ur30_1::ur30_1_position_controller::ur30_1::wrist_3_link</parent>
        <child>box::box_link</child>
        <axis>
            <dynamics>
                <spring_stiffness>10000</spring_stiffness>
            </dynamics>
            <limit>
                <upper>0.1</upper>
                <lower>-0.1</lower>
            </limit>
        </axis>
    </joint>

    <model name="my_model">
    <pose>1.0 1.0 0.5 0 0 0</pose>
    <static>true</static>
    <link name="link">
      <inertial>
        <mass>1.0</mass>
        <inertia> <!-- inertias are tricky to compute -->
          <!-- http://gazebosim.org/tutorials?tut=inertia&cat=build_robot -->
          <ixx>0.083</ixx>       <!-- for a box: ixx = 0.083 * mass * (y*y + z*z) -->
          <ixy>0.0</ixy>         <!-- for a box: ixy = 0 -->
          <ixz>0.0</ixz>         <!-- for a box: ixz = 0 -->
          <iyy>0.083</iyy>       <!-- for a box: iyy = 0.083 * mass * (x*x + z*z) -->
          <iyz>0.0</iyz>         <!-- for a box: iyz = 0 -->
          <izz>0.083</izz>       <!-- for a box: izz = 0.083 * mass * (x*x + y*y) -->
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>1 1 1</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>1 1 1</size>
          </box>
        </geometry>
      </visual>
    </link>
  </model>

    </world>
</sdf>
